  "idx.safe.311": "1. RWTH Aachen",
  "idx.safe.312": "📍 AACHEN",
  "idx.safe.313": "RWTH Aachen",
  "idx.safe.314": "Avrupa'nın önde gelen teknik üniversitelerinden biri. Makine ve otomotiv mühendisliğinde Almanya'nın zirvesi.",
  "idx.safe.315": "2. LMU Munich",
  "idx.safe.316": "📍 MÜNİH",
  "idx.safe.317": "Almanya'nın en köklü ve başarılı üniversitelerinden. Beşeri bilimler, tıp ve fen bilimlerinde dünya standartlarında.",
  "idx.safe.318": "3. TU Berlin",
  "idx.safe.319": "📍 BERLİN",
  "idx.safe.320": "4. KIT",
  "idx.safe.321": "📍 KARLSRUHE",
  "idx.safe.322": "5. FU Berlin",
  "idx.safe.323": "📍 BERLİN",
  "idx.safe.324": "6. Uni Freiburg",
  "idx.safe.325": "📍 FREİBURG",
  "idx.safe.326": "7. Uni Tübingen",
  "idx.safe.327": "📍 TÜBİNGEN",
  "idx.safe.328": "8. Uni Bonn",
  "idx.safe.329": "📍 BONN",
  "idx.safe.330": "9. Uni Göttingen",
